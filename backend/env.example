# Database
DATABASE_URL=sqlite+aiosqlite:///./data/study.db

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace_with_random_secret_at_least_32_chars
# Optional. Defaults to SECRET_KEY if empty. Keep stable or saved AI keys cannot be decrypted.
AI_KEY_ENCRYPTION_SECRET=

# AI Provider Configuration
# 选择默认的 AI 提供商: openai, claude, gemini, qwen
DEFAULT_AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-opus-20240229

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Qwen
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-turbo

# Server
HOST=0.0.0.0
PORT=8000
# Use DEBUG=True only for local development. Production startup rejects weak SECRET_KEY values.
DEBUG=False
ENVIRONMENT=development

# Projection outbox worker (PostgreSQL only; SQLite keeps request-time consumption)
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_MAX_ATTEMPTS=5
OUTBOX_WORKER_RETRY_POLICY_VERSION=1
# Optional logical prefix. Each runtime appends its own opaque instance suffix.
OUTBOX_WORKER_ID=
OUTBOX_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
OUTBOX_WORKER_HEARTBEAT_TTL_SECONDS=45
OUTBOX_ALERT_BACKLOG_COUNT_THRESHOLD=100
OUTBOX_ALERT_BACKLOG_AGE_SECONDS=900
OUTBOX_ALERT_TERMINAL_FAILURE_THRESHOLD=1
OUTBOX_ALERT_STALE_PROCESSING_THRESHOLD=1
# Enables the private /internal/outbox/metrics scrape endpoint when set.
OUTBOX_OPS_TOKEN=

# CORS: set this to your exact frontend origin(s) in production; do not use '*'.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Upload limits
MATERIAL_UPLOAD_MAX_MB=200
IMAGE_UPLOAD_MAX_MB=50
MAX_REQUEST_BODY_MB=20

# Production protection
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
