# Database
DATABASE_URL=sqlite+aiosqlite:///./data/study.db

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace_with_random_secret_at_least_32_chars
# Optional. Defaults to SECRET_KEY if empty. Keep stable or saved AI keys cannot be decrypted.
AI_KEY_ENCRYPTION_SECRET=

# AI Provider Configuration
# 选择默认的 AI 提供商: openai, claude, gemini, qwen
DEFAULT_AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-opus-20240229

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Qwen
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-turbo

# Mnemox V2 feature flags. Stage 6 finished with Neo4j/Graphiti NO-GO;
# graph product flags stay false. Shadow settings are retained only for reproducible Spike tests.
KNOWLEDGE_V2_ENABLED=false
KNOWLEDGE_LLM_EXTRACTION_ENABLED=false
ASSOCIATION_V2_ENABLED=false
ASSOCIATION_V2_SHADOW=false
ASSOCIATION_MULTIHOP_EXPLANATION_ENABLED=false
KNOWLEDGE_PATH_ENABLED=false
KNOWLEDGE_SEMANTIC_AUTO_RESOLVE_ENABLED=false
GRAPH_BACKEND=sql
# When GRAPH_BACKEND=neo4j, admit a stable percentage of users to Neo4j reads.
# Explicit user IDs are always included and are useful for canary accounts.
NEO4J_GRAPH_ROLLOUT_PERCENT=100
NEO4J_GRAPH_ROLLOUT_USER_IDS=
NEO4J_GRAPH_ENABLED=false
NEO4J_GRAPH_SHADOW=false
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_GRAPH_SHADOW_TIMEOUT_SECONDS=2
GRAPHITI_ENABLED=false
GRAPHITI_SHADOW=false
GRAPHITI_SHADOW_TIMEOUT_SECONDS=5
GRAPHITI_TELEMETRY_ENABLED=false
KNOWLEDGE_EXTRACTION_MAX_UNIT_CHARS=8000
KNOWLEDGE_EXTRACTION_MAX_CLAIMS_PER_UNIT=12
KNOWLEDGE_CLAIM_MAX_CHARS=500
KNOWLEDGE_EXTRACTION_MAX_OUTPUT_CHARS=12000
KNOWLEDGE_EXTRACTION_TIMEOUT_SECONDS=30
KNOWLEDGE_LLM_MAX_CALLS_PER_RUN=64
KNOWLEDGE_LLM_MAX_ESTIMATED_TOKENS_PER_RUN=64000
KNOWLEDGE_LLM_DAILY_ESTIMATED_TOKENS_PER_USER=256000
KNOWLEDGE_EXTRACTION_WORKER_POLL_INTERVAL_SECONDS=2
KNOWLEDGE_EXTRACTION_WORKER_BATCH_SIZE=4
KNOWLEDGE_EXTRACTION_MAX_ATTEMPTS=5
KNOWLEDGE_EXTRACTION_LEASE_SECONDS=120
KNOWLEDGE_EXTRACTION_RETRY_BASE_SECONDS=5
KNOWLEDGE_EMBEDDING_ENABLED=false
KNOWLEDGE_CHROMA_COLLECTION_NAME=mnemox_knowledge
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=20
KNOWLEDGE_RESOLUTION_TOP_K=5
KNOWLEDGE_RESOLUTION_LEXICAL_THRESHOLD=0.45
KNOWLEDGE_RESOLUTION_MAX_MENTIONS_PER_CLAIM=8
KNOWLEDGE_PROJECTION_WORKER_POLL_INTERVAL_SECONDS=2
KNOWLEDGE_PROJECTION_WORKER_BATCH_SIZE=20
KNOWLEDGE_PROJECTION_MAX_ATTEMPTS=5
KNOWLEDGE_PROJECTION_LEASE_SECONDS=120
KNOWLEDGE_PROJECTION_RETRY_BASE_SECONDS=5

# Server
HOST=0.0.0.0
PORT=8000
# Use DEBUG=True only for local development. Production startup rejects weak SECRET_KEY values.
DEBUG=False
ENVIRONMENT=development

# Projection outbox worker (PostgreSQL only; SQLite keeps request-time consumption)
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_MAX_ATTEMPTS=5
OUTBOX_WORKER_RETRY_POLICY_VERSION=1

# Opt-in AgentRuntime review-debt scheduler. Each user is evaluated at most
# once per interval; failures use the shorter bounded retry interval.
AGENT_RUNTIME_SCHEDULER_ENABLED=true
AGENT_RUNTIME_POLL_INTERVAL_SECONDS=300
AGENT_RUNTIME_BATCH_SIZE=50
AGENT_RUNTIME_USER_INTERVAL_SECONDS=21600
AGENT_RUNTIME_RETRY_INTERVAL_SECONDS=900
AGENT_RUNTIME_USER_TIMEOUT_SECONDS=60
COACH_INTERVENTION_EXPERIMENT_ENABLED=false
COACH_INTERVENTION_EXPERIMENT_ID=coach_intervention_aa_v1
COACH_INTERVENTION_EXPERIMENT_SPLIT_PERCENT=50
AGENT_KERNEL_LEASE_SECONDS=120
AGENT_KERNEL_MAX_MODEL_CALLS=7
AGENT_KERNEL_MAX_ESTIMATED_TOKENS=32000
AGENT_KERNEL_DAILY_MODEL_CALLS_PER_USER=30
AGENT_KERNEL_DAILY_ESTIMATED_TOKENS_PER_USER=128000
# Optional logical prefix. Each runtime appends its own opaque instance suffix.
OUTBOX_WORKER_ID=
OUTBOX_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
OUTBOX_WORKER_HEARTBEAT_TTL_SECONDS=45
OUTBOX_ALERT_BACKLOG_COUNT_THRESHOLD=100
OUTBOX_ALERT_BACKLOG_AGE_SECONDS=900
OUTBOX_ALERT_TERMINAL_FAILURE_THRESHOLD=1
OUTBOX_ALERT_STALE_PROCESSING_THRESHOLD=1
# Enables the private /internal/outbox/metrics scrape endpoint when set.
OUTBOX_OPS_TOKEN=

# CORS: set this to your exact frontend origin(s) in production; do not use '*'.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Upload limits
MATERIAL_UPLOAD_MAX_MB=200
IMAGE_UPLOAD_MAX_MB=50
MAX_REQUEST_BODY_MB=20

# Production protection
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
