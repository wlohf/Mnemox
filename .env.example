# Database
DB_PASSWORD=replace_with_strong_database_password

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace_with_random_secret_at_least_32_chars
AI_KEY_ENCRYPTION_SECRET=

# AI Provider Keys (configure at least one)
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=

# App Update
APP_VERSION=1.2.0
APP_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/wlohf/Mnemox/main/release-manifest/latest.json

# Security / upload limits
MATERIAL_UPLOAD_MAX_MB=200
IMAGE_UPLOAD_MAX_MB=50
MAX_REQUEST_BODY_MB=20
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# Projection outbox worker (PostgreSQL only; SQLite keeps request-time consumption)
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_MAX_ATTEMPTS=5
# Increment when intentionally changing the shared retry cap.
OUTBOX_WORKER_RETRY_POLICY_VERSION=1
# Optional logical prefix. Each runtime appends its own opaque instance suffix.
OUTBOX_WORKER_ID=
# PostgreSQL worker heartbeats and aggregate outbox alert thresholds.
OUTBOX_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
OUTBOX_WORKER_HEARTBEAT_TTL_SECONDS=45
OUTBOX_ALERT_BACKLOG_COUNT_THRESHOLD=100
OUTBOX_ALERT_BACKLOG_AGE_SECONDS=900
OUTBOX_ALERT_TERMINAL_FAILURE_THRESHOLD=1
OUTBOX_ALERT_STALE_PROCESSING_THRESHOLD=1
# Required to enable /internal/outbox/metrics; never expose this endpoint through the public frontend proxy.
OUTBOX_OPS_TOKEN=
