# Database
DB_PASSWORD=replace_with_strong_database_password

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace_with_random_secret_at_least_32_chars
AI_KEY_ENCRYPTION_SECRET=

# AI Provider Keys (configure at least one)
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=

# App Update
APP_VERSION=1.2.0
APP_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/wlohf/Mnemox/main/release-manifest/latest.json

# Security / upload limits
MATERIAL_UPLOAD_MAX_MB=200
IMAGE_UPLOAD_MAX_MB=50
MAX_REQUEST_BODY_MB=20
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# The public Caddy -> Nginx -> backend topology has exactly two trusted hops.
# Leave both values at their safe defaults for local development or any
# deployment where the backend has a public port.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_MAX_BUCKETS=10000
# In public deployments, account-configured AI/RAG endpoints must resolve to
# public HTTPS addresses. Set true only for a deliberately private deployment.
ALLOW_PRIVATE_AI_ENDPOINTS=false
# RAG Embedding is shared by the whole server. In production, only these
# comma-separated usernames may update/test it from the UI; leave blank to
# manage it exclusively through deployment environment variables.
RAG_SETTINGS_ADMIN_USERNAMES=your_admin_username
ACCESS_TOKEN_EXPIRE_HOURS=12
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_ACCOUNT_MAX_FAILURES=5
AUTH_ACCOUNT_WINDOW_SECONDS=900
MAX_IMAGE_PIXELS=40000000
MAX_OBSIDIAN_ATTACHMENTS=20
MATERIAL_EXTRACT_MAX_CHARS=2000000
MATERIAL_EXTRACT_TIMEOUT_SECONDS=20
MATERIAL_ARCHIVE_MAX_UNCOMPRESSED_MB=50

# Projection outbox worker (PostgreSQL only; SQLite keeps request-time consumption)
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_MAX_ATTEMPTS=5
# Increment when intentionally changing the shared retry cap.
OUTBOX_WORKER_RETRY_POLICY_VERSION=1
# Optional logical prefix. Each runtime appends its own opaque instance suffix.
OUTBOX_WORKER_ID=
# PostgreSQL worker heartbeats and aggregate outbox alert thresholds.
OUTBOX_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
OUTBOX_WORKER_HEARTBEAT_TTL_SECONDS=45
OUTBOX_ALERT_BACKLOG_COUNT_THRESHOLD=100
OUTBOX_ALERT_BACKLOG_AGE_SECONDS=900
OUTBOX_ALERT_TERMINAL_FAILURE_THRESHOLD=1
OUTBOX_ALERT_STALE_PROCESSING_THRESHOLD=1
# Required to enable /internal/outbox/metrics; never expose this endpoint through the public frontend proxy.
OUTBOX_OPS_TOKEN=

# Proactive AgentRuntime (PostgreSQL server only). No user is evaluated until
# that user turns on "定时评估" in Coach settings.
AGENT_RUNTIME_SCHEDULER_ENABLED=true
AGENT_RUNTIME_POLL_INTERVAL_SECONDS=300
AGENT_RUNTIME_BATCH_SIZE=50
